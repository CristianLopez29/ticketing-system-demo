# Production template for the Dockerised stack in compose.prod.yaml, behind the shared
# Traefik proxy on a VPS that also hosts other applications.
# Copy to .env on the server and fill every <placeholder>.
# See docs/DEPLOYMENT.md for the full procedure.

APP_NAME=Ticketing
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-domain>

# Host Traefik matches on, interpolated into the router rule in compose.prod.yaml.
# Bare hostname, no scheme. Point its A record at the VPS BEFORE the first
# `up -d`: the TLS-ALPN challenge fails otherwise and repeated failures burn
# through the Let's Encrypt rate limit for the domain.
APP_DOMAIN=<your-domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# JSON lines, rotated daily, kept out of the access log.
LOG_CHANNEL=daily_json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_ACCESS_DAYS=14

# Service names on the stack's internal Docker network, not host addresses.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ticketing
DB_USERNAME=ticketing
DB_PASSWORD=<strong-database-password>
DB_ROOT_PASSWORD=<strong-root-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=<strong-redis-password>
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@<your-domain>"
MAIL_FROM_NAME="${APP_NAME}"

# "*" is correct here and only here: compose.prod.yaml publishes no ports, so the only
# route to the web container is the shared Traefik proxy and X-Forwarded-For cannot be
# forged by an outside client. Publish a port and this must become the proxy's IP.
# Get it wrong and every per-IP rate limit degrades into one shared bucket.
TRUSTED_PROXIES=*

# Narrow this the moment a browser client exists.
CORS_ALLOWED_ORIGINS=*

# Swagger UI, reachable at /api/documentation behind HTTP Basic auth.
L5_SWAGGER_CONST_HOST="https://<your-domain>"
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_PROTECT=true
DOCS_AUTH_USERNAME=docs
DOCS_AUTH_PASSWORD=<strong-docs-password>

SANCTUM_EXPIRATION=60

# php -r "echo bin2hex(random_bytes(32));"
HEALTHCHECK_TOKEN=<32-bytes-of-entropy>

# Empty DSN disables Sentry entirely.
SENTRY_LARAVEL_DSN=<https://key@oNNN.ingest.sentry.io/NNN>
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

PAYMENT_GATEWAY_DRIVER=fake
