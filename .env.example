APP_NAME=Ticketing
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# For a public deployment start from .env.production.example instead: this file is the
# local/CI template and deliberately leaves APP_DEBUG on.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Application log. Use "daily_json" in production for JSON lines with daily rotation.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_ACCESS_DAYS=14

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE must be true in production (requires HTTPS).
# Set to false ONLY in local development without TLS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated proxy IPs/CIDRs, or "*" behind a CDN. Wrong values silently disable
# every per-IP rate limit, because $request->ip() then returns the proxy address.
TRUSTED_PROXIES=127.0.0.1,::1

# Comma-separated origins, or "*". Safe as "*" only while auth stays bearer-token only.
CORS_ALLOWED_ORIGINS=*

# Swagger UI. Protected with HTTP Basic auth whenever APP_ENV is not "local"; with
# L5_SWAGGER_PROTECT=true and no password set, the docs route answers 503 rather than opening.
L5_SWAGGER_CONST_HOST="http://localhost"
L5_SWAGGER_GENERATE_ALWAYS=false
# L5_SWAGGER_PROTECT=true
DOCS_AUTH_USERNAME=docs
DOCS_AUTH_PASSWORD=

SANCTUM_EXPIRATION=60

# Reserved for src/Shared/Infrastructure/Middleware/HealthCheckAuth.php, which is not
# registered on any route today: the probes are open on purpose.
HEALTHCHECK_TOKEN=change_me_strong_token

# Error monitoring. Leave the DSN empty to disable Sentry entirely.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

WWWUSER=1000
WWWGROUP=1000

# Payment Gateway: 'fake' (dev/test) | 'stripe' (production)
PAYMENT_GATEWAY_DRIVER=fake
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
